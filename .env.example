# Autor: Raul Rubio - Pt04
# Copia este fichero como ".env" y rellena los valores de Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Web application).
# El fichero .env está en .gitignore: las credenciales nunca se suben a Git.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional. Si se deja vacío se calcula solo (http://<host>/<carpeta>/oauth_callback.php).
# Tiene que coincidir EXACTAMENTE con la "Authorized redirect URI" de Google.
GOOGLE_REDIRECT_URI=http://localhost/ProjecteBackendDisseny/umamusume/oauth_callback.php
